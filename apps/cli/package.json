{
  "name": "@taskell/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Taskell command line interface.",
  "license": "MIT",
  "bin": {
    "taskell": "./dist/js/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/js/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "build:sea": "vp pack src/index.ts -f cjs -d dist/sea --no-dts --no-exports && node --build-sea sea-config.json",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@taskell/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "inlinedDependencies": {
    "nanoid": "5.1.9",
    "neverthrow": "8.2.0",
    "temporal-polyfill": "0.3.2"
  }
}
