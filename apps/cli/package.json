{
  "name": "@taskell/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Taskell command line interface.",
  "license": "MIT",
  "bin": {
    "taskell": "./dist/js/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/js/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --out-dir dist/js --no-dts --clean",
    "build:sea": "tsdown src/index.ts --format cjs --out-dir dist/sea --no-dts --no-exports --clean && node --build-sea sea-config.json",
    "check": "pnpm typecheck",
    "dev": "tsdown src/index.ts --format esm --out-dir dist/js --no-dts --clean --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@taskell/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "nanoid": "5.1.9",
    "neverthrow": "8.2.0",
    "temporal-polyfill": "0.3.2"
  }
}
