{
  "name": "@taskell/core",
  "version": "0.0.0",
  "private": true,
  "description": "Taskell headless task management core.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "check": "pnpm typecheck",
    "dev": "tsdown src/index.ts --format esm --dts --clean --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "nanoid": "^5.1.5",
    "neverthrow": "^8.2.0",
    "pino": "^9.9.5",
    "temporal-polyfill": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
